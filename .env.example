# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300

# Models
DEFAULT_MODEL=qwen2.5-coder:7b
PLANNING_MODEL=llama3.2:3b
BACKEND_MODEL=qwen2.5-coder:7b
FRONTEND_MODEL=qwen2.5-coder:7b
QA_MODEL=llama3.2:3b
SUMMARIZER_MODEL=llama3.2:3b

# Limits & Paths
MAX_CONTEXT_CHARS=8000
OUTPUT_DIR=outputs
STATE_FILE=orchestrator_state.json
CONTEXT_FILE=orchestrator_context.md

# Debug/Logging
LOG_FORMAT=console
DEBUG=false
